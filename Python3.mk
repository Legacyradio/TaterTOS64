# Python-3.14 target for TaterTOS64v3
# Auto-generated by hermes020. See HERMES_NATIVE_PLAN.txt Phase 2.
#
# Build dependencies:
#   1. src/include/*.h must be up-to-date (gap matrix hermes001-hermes020)
#   2. Python-3.14.5/pyconfig.h must exist (pyconfig_tater.h)
#   3. Python-3.14.5/Python/frozen_modules/*.h must be generated
#
# Usage: make -f Python3.mk python3
# Must be run from TaterTOS64 root directory.

# -----------------------------------------------------------------------
# Toolchain (must match main Makefile)
# -----------------------------------------------------------------------
TOOLBIN = $(CURDIR)/tools/host/bin
CC = $(TOOLBIN)/x86_64-elf-gcc
LD = $(TOOLBIN)/x86_64-elf-ld
# fry1805: header dependency tracking. WHY: this makefile had NONE, so editing a
# header rebuilt NOTHING here — the same defect that cost a day in fry1792-1795
# on the main Makefile (fixed there in fry1796). It bit immediately: the
# _SC_IOV_MAX fix edits src/include/unistd.h, and without this CPython's
# posixmodule.o would never recompile and the fix would silently not take.
# -MMD emits a .d sidecar per object; -MP adds phony header targets so a deleted
# or renamed header cannot wedge the build with "No rule to make target".
# Added to UFLAGS because CPYTHON_CFLAGS derives from it, so every compile rule
# in this file inherits it.
DEPFLAGS = -MMD -MP
UFLAGS = -ffreestanding -fno-stack-protector -O2 -std=gnu11 -Wall -Wextra -Isrc/include -Isrc/user/libc $(DEPFLAGS)

# LIBC objects (must match main Makefile)
LIBC_OBJ = src/user/libc/libc.o src/user/libc/errno.o src/user/libc/gfx.o \
  src/user/libc/string_ext.o src/user/libc/stdio.o src/user/libc/math.o \
  src/user/libc/posix.o src/user/libc/pthread.o src/user/libc/netdb.o \
  src/user/libc/time_ext.o src/user/libc/dlfcn.o src/user/libc/setjmp.o \
  src/user/libc/gap_stubs.o \
  src/user/libc/rust_compat.o \
  src/user/apps/openssl/openssl_stubs.o

# -----------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------
CPYTHON_DIR = /home/legacyindieradio/TaterTOS64/external/Python-3.14.5
CPYTHON_OBJDIR = $(CPYTHON_DIR)/build-tatertos
CPYTHON_INSTALL = /home/legacyindieradio/TaterTOS64/sysroot/usr/local

# -----------------------------------------------------------------------
# Compile flags (matching CPython's Makefile.pre.in + TaterTOS UFLAGS)
# -----------------------------------------------------------------------
CPYTHON_CFLAGS = $(UFLAGS) -ffunction-sections -fdata-sections \
    -Wno-unused-parameter -Wno-unused-function -Wno-missing-field-initializers \
    -Wno-error -Wno-implicit-function-declaration -Wno-int-conversion \
    -DPy_BUILD_CORE \
    -DPREFIX='"/usr/local"' \
    -DEXEC_PREFIX='"/usr/local"' \
    -DVERSION='"3.14"' \
    -DABIFLAGS='""' \
    -DVPATH='""' \
    -DPLATLIBDIR='"lib"' \
    -DHACL_CAN_COMPILE_VEC128=0 \
    -DHACL_CAN_COMPILE_VEC256=0 \
    -I$(CPYTHON_DIR)/Modules \
    -I$(CPYTHON_DIR)/Modules/_hacl \
    -I$(CPYTHON_DIR)/Modules/_hacl/include \
    -I$(CPYTHON_DIR) \
