CPYTHON_SQLITE_SRCS =     $(CPYTHON_DIR)/Modules/_sqlite/module.c     $(CPYTHON_DIR)/Modules/_sqlite/connection.c     $(CPYTHON_DIR)/Modules/_sqlite/cursor.c     $(CPYTHON_DIR)/Modules/_sqlite/statement.c     $(CPYTHON_DIR)/Modules/_sqlite/row.c     $(CPYTHON_DIR)/Modules/_sqlite/blob.c     $(CPYTHON_DIR)/Modules/_sqlite/prepare_protocol.c     $(CPYTHON_DIR)/Modules/_sqlite/util.c     $(CPYTHON_DIR)/Modules/_sqlite/microprotocols.c

CPYTHON_SQLITE_OBJS = $(patsubst $(CPYTHON_DIR)/%,$(CPYTHON_OBJDIR)/%,$(CPYTHON_SQLITE_SRCS:.c=.o))

# _sqlite3 module includes (needs external sqlite3.h)
SQLITE_INC = -I$(SQLITE_DIR)

$(CPYTHON_OBJDIR)/Modules/_sqlite/%.o: $(CPYTHON_DIR)/Modules/_sqlite/%.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) $(SQLITE_INC) -c $< -o $@

# config.c needs PyInit__sqlite3 — enable in pyconfig

