# fry1808: pyexpat + bundled libexpat. Defined HERE (before CPYTHON_ALL_OBJS and
# the `python3:` rule) for the same reason as the sqlite block below — make
# expands prerequisites at rule-read time, so a later definition would silently
# expand to empty and the objects would never be built (the fry1806 bug).
#
# ONLY THREE expat translation units compile: xmltok_impl.c and xmltok_ns.c are
# #include'd BY xmltok.c (xmltok.c:307 and :1646), so compiling them separately
# would produce duplicate symbols. Do not "helpfully" add them.
CPYTHON_EXPAT_SRCS = $(CPYTHON_DIR)/Modules/expat/xmlparse.c $(CPYTHON_DIR)/Modules/expat/xmlrole.c $(CPYTHON_DIR)/Modules/expat/xmltok.c
CPYTHON_EXPAT_OBJS = $(patsubst $(CPYTHON_DIR)/%,$(CPYTHON_OBJDIR)/%,$(CPYTHON_EXPAT_SRCS:.c=.o))
CPYTHON_PYEXPAT_OBJ = $(CPYTHON_OBJDIR)/Modules/pyexpat.o

# HAVE_EXPAT_CONFIG_H makes expat read Modules/expat/expat_config.h, which
# already sets XML_POOR_ENTROPY=1 and #undefs HAVE_GETRANDOM/HAVE_ARC4RANDOM —
# i.e. it is already configured for an environment with no /dev/urandom and no
# getrandom syscall, which is exactly TaterTOS. XML_STATIC because we link expat
# straight into python3.fry rather than a shared lib. USE_PYEXPAT_CAPI matches
# CPython's own build of this module.
EXPAT_DEFS = -DHAVE_EXPAT_CONFIG_H=1 -DXML_STATIC=1 -DUSE_PYEXPAT_CAPI
EXPAT_INC  = -I$(CPYTHON_DIR)/Modules/expat

# libexpat is THIRD-PARTY and must NOT inherit CPYTHON_CFLAGS. CPython's build
# defines -DVERSION='"3.14"' and -DPREFIX='"/usr/local"' (among others), and
# those names collide with ordinary identifiers inside expat, producing
# "<command-line>: error: expected identifier or '(' before string constant"
# and bogus follow-on errors like "'ELEMENT_TYPE' has no member named
# 'nDefaultAtts'". So expat gets plain UFLAGS + its own defines/includes only.
# pyexpat.c is DIFFERENT — it is CPython glue and does need CPYTHON_CFLAGS.
# expat_config.h:8 #includes pyconfig.h, so expat DOES need CPython's include
# PATHS — it just must not get CPython's -D defines. Hence paths kept, the
# string defines (VERSION/PREFIX/EXEC_PREFIX/ABIFLAGS/VPATH/PLATLIBDIR) dropped.
EXPAT_CFLAGS = $(UFLAGS) -ffunction-sections -fdata-sections \
    -DPy_BUILD_CORE $(EXPAT_DEFS) $(EXPAT_INC) \
    -I$(CPYTHON_DIR) \
    -I$(CPYTHON_DIR)/Include \
    -I$(CPYTHON_DIR)/Include/internal \
    -I$(CPYTHON_DIR)/Modules \
    -Wno-unused-parameter -Wno-unused-function -Wno-missing-field-initializers

# fry1806: CPYTHON_SQLITE_SRCS/OBJS MUST be defined BEFORE the `python3:` rule
# that consumes them. They used to be defined ~line 330, i.e. AFTER it. Make
# expands a rule's PREREQUISITES when the rule is READ, so $(CPYTHON_SQLITE_OBJS)
# expanded to EMPTY there and the _sqlite objects were never prerequisites — yet
# the RECIPE expands at execution time, when the variable IS set, so the link
# command still referenced them. Net effect: make never built them and ld failed
# with "cannot find .../Modules/_sqlite/module.o". This stayed hidden for as long
# as those .o files happened to survive from an older build; deleting them for
# the fry1805 dependency-tracking rebuild exposed it.
CPYTHON_SQLITE_SRCS = $(CPYTHON_DIR)/Modules/_sqlite/module.c $(CPYTHON_DIR)/Modules/_sqlite/connection.c $(CPYTHON_DIR)/Modules/_sqlite/cursor.c $(CPYTHON_DIR)/Modules/_sqlite/statement.c $(CPYTHON_DIR)/Modules/_sqlite/row.c $(CPYTHON_DIR)/Modules/_sqlite/blob.c $(CPYTHON_DIR)/Modules/_sqlite/prepare_protocol.c $(CPYTHON_DIR)/Modules/_sqlite/util.c $(CPYTHON_DIR)/Modules/_sqlite/microprotocols.c
CPYTHON_SQLITE_OBJS = $(patsubst $(CPYTHON_DIR)/%,$(CPYTHON_OBJDIR)/%,$(CPYTHON_SQLITE_SRCS:.c=.o))

CPYTHON_ALL_OBJS = $(CPYTHON_PYTHON_OBJS) $(CPYTHON_OBJECTS_OBJS) $(CPYTHON_MIMALLOC_OBJS) $(CPYTHON_PARSER_OBJS) $(CPYTHON_MODULES_OBJS) $(CPYTHON_PROGRAMS_OBJS) $(CPYTHON_PYTHON_EXTRA_OBJS) $(CPYTHON_OBJDIR)/Modules/_ssl.o $(CPYTHON_OBJDIR)/sqlite3.o $(CPYTHON_SQLITE_OBJS) $(CPYTHON_EXPAT_OBJS) $(CPYTHON_PYEXPAT_OBJ)

# Python extra objects (from CPYTHON_PYTHON_EXTRA)
CPYTHON_PYTHON_EXTRA_OBJS = $(patsubst $(CPYTHON_DIR)/Python/%.c,$(CPYTHON_OBJDIR)/___Python_%.o,$(CPYTHON_PYTHON_EXTRA))

# -----------------------------------------------------------------------
# Final target
# -----------------------------------------------------------------------
CPYTHON_OBJS = $(LIBC_OBJ) $(CPYTHON_ALL_OBJS)

# Native Rust extension: pydantic_core built for x86_64-tatertos against our OWN
# native Rust std + libc fork (fry1742). Replaces the dead linux-gnu .a. + libgcc
# for the compiler-rt softfloat/int128/unwind symbols (fry1730).
PDC_LIB = /home/legacyindieradio/TaterTOS64/rust/pydantic_core-2.46.4/target/x86_64-tatertos/release/lib_pydantic_core.a
# Native Python C extensions for x86_64-tatertos (httptools = Cython + llhttp).
HTTPTOOLS_LIB = /home/legacyindieradio/TaterTOS64/rust/pyext-src/build-httptools/libhttptools.a
WATCHFILES_LIB = /home/legacyindieradio/TaterTOS64/rust/pyext-src/watchfiles-1.1.1/target/x86_64-tatertos/release/lib_rust_notify.a
PILLOW_LIB = /home/legacyindieradio/TaterTOS64/rust/pyext-src/build-pillow/libpillow.a
# Pillow's in-tree image codec libs (zlib/jpeg/png/freetype/webp).
PILLOW_IMGLIBS = external/lib/libfreetype.a external/lib/libpng.a external/lib/libjpeg.a \
                 external/lib/libz.a
PYEXT_LIBS = $(HTTPTOOLS_LIB) $(WATCHFILES_LIB) $(PILLOW_LIB) $(PILLOW_IMGLIBS)
LIBGCC = $(shell $(CC) -print-libgcc-file-name)

# --allow-multiple-definition: each Rust staticlib (pydantic_core, watchfiles, ...)
# bundles its own copy of the IDENTICAL Rust std runtime (rust_panic, eh_personality,
# __rdl_alloc, ...). Linking >1 Rust ext duplicates them; they're the same impl
# BearSSL objects (already built by the main Makefile for TaterSurf) — linked
# into python3 to back the native _ssl module. fry1781.
BEARSSL_SRC = src/user/apps/bearssl/src
BEARSSL_OBJS = $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/aead/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/codec/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/ec/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/hash/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/int/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/kdf/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/mac/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/rand/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/rsa/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/ssl/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/symcipher/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(BEARSSL_SRC)/x509/*.c)) \
  $(BEARSSL_SRC)/settings.o \
  src/user/apps/bearssl/tatertos_rt.o

# (same toolchain+target) so the linker safely keeps the first.
python3: $(CPYTHON_OBJS) $(PDC_LIB) $(PYEXT_LIBS)
	$(LD) -T user_linker.ld --gc-sections --allow-multiple-definition -o python3.elf $(CPYTHON_OBJS) $(PDC_LIB) $(PYEXT_LIBS) $(BEARSSL_OBJS) $(LIBGCC)
	./tools/frypack.py python3.elf python3.fry
	@echo "=== python3.fry built ==="
	@echo "WARNING: still needs stdlib installation at /usr/local/lib/python3.14/"

# -----------------------------------------------------------------------
# Compile rules
# -----------------------------------------------------------------------

$(CPYTHON_OBJDIR):
	mkdir -p $(CPYTHON_OBJDIR)

# fry1805: pull back the .d sidecars emitted by -MMD above.
#
# Scoped to the two directories this makefile actually WRITES objects into:
# $(CPYTHON_OBJDIR) (external/Python-3.14.5/build-tatertos) and src/user.
# It is NOT scoped to $(CPYTHON_DIR) as a whole ON PURPOSE: `.d` is also
# DTrace's provider-source suffix and external/Python-3.14.5/Include/pydtrace.d
# is exactly such a file — feeding that to make yields "missing separator. Stop."
# Each candidate must also have a sibling .o proving we generated it, so an
# orphaned .d (source deleted, object cleaned) is ignored rather than wedging
# the build.
PY_DEPFILES := $(shell find $(CPYTHON_OBJDIR) src/user -name '*.d' \
                 -exec sh -c '[ -f "$${1%.d}.o" ]' _ {} \; -print 2>/dev/null)
-include $(PY_DEPFILES)

$(CPYTHON_OBJDIR)/___Python_%.o: $(CPYTHON_DIR)/Python/%.c | $(CPYTHON_OBJDIR)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

$(CPYTHON_OBJDIR)/___Objects_%.o: $(CPYTHON_DIR)/Objects/%.c | $(CPYTHON_OBJDIR)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

$(CPYTHON_OBJDIR)/Parser/%.o: $(CPYTHON_DIR)/Parser/%.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

$(CPYTHON_OBJDIR)/Modules/%.o: $(CPYTHON_DIR)/Modules/%.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

$(CPYTHON_OBJDIR)/Programs/%.o: $(CPYTHON_DIR)/Programs/%.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

# gap_stubs (libc stub implementations)
src/user/libc/gap_stubs.o: src/user/libc/gap_stubs.c
	$(CC) $(UFLAGS) -Wno-misleading-indentation -c $< -o $@

src/user/apps/openssl/openssl_stubs.o: src/user/apps/openssl/openssl_stubs.c
	$(CC) $(UFLAGS) -Wno-unused -c $< -o $@

# SQLite3 amalgamation
SQLITE_DIR = /home/legacyindieradio/TaterTOS64/external/sqlite-amalgamation-3490000
# fry1681: THREADSAFE=0 (was 1). SQLite's recursive mutexes (sqlite3_initialize
# re-enters its static-init mutex) self-deadlock on TaterTOS's non-recursive
# pthread_mutex. CPython here is single-threaded, so the no-mutex config is
# correct and removes the deadlock.
SQLITE_CFLAGS = $(UFLAGS) -DSQLITE_OS_UNIX=1 -DSQLITE_THREADSAFE=0 \
    -DSQLITE_OMIT_LOAD_EXTENSION -Wno-unused-parameter -Wno-unused-function

$(CPYTHON_OBJDIR)/sqlite3.o: $(SQLITE_DIR)/sqlite3.c | $(CPYTHON_OBJDIR)
	$(CC) $(SQLITE_CFLAGS) -c $< -o $@

# Native _ssl module — BearSSL-backed (replaces the stub). fry1781.
$(CPYTHON_OBJDIR)/Modules/_ssl.o: src/user/apps/_ssl/_ssl_bearssl.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) -c $< -o $@

# fry1808: libexpat + pyexpat. These need EXPAT_DEFS/EXPAT_INC, so they get their
# own rules rather than falling into the generic Modules/%.o rule. Declared after
# that generic rule but matched ahead of it: for a target like
# .../Modules/expat/xmlparse.o the expat pattern yields the shorter stem, and
# pyexpat.o is an explicit (non-pattern) target, which always wins.
$(CPYTHON_OBJDIR)/Modules/expat/%.o: $(CPYTHON_DIR)/Modules/expat/%.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(EXPAT_CFLAGS) -c $< -o $@

$(CPYTHON_OBJDIR)/Modules/pyexpat.o: $(CPYTHON_DIR)/Modules/pyexpat.c | $(CPYTHON_OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPYTHON_CFLAGS) $(EXPAT_DEFS) $(EXPAT_INC) -c $< -o $@

